<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only. Certificate pinning is added in OkHttp (NetworkModule) so pins can rotate with releases. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
